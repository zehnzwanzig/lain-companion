[Unit]
Description=Lain desktop companion
PartOf=graphical-session.target
After=plasma-plasmashell.service

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/lain-companion
ExecStart=/usr/bin/bash -c '/usr/bin/curl --noproxy "*" --fail --silent --show-error --output /dev/null --max-time 2 --retry 30 --retry-connrefused --retry-delay 1 http://127.0.0.1:11434/api/tags && exec ./launch.sh'
Restart=on-abnormal
RestartSec=5

[Install]
WantedBy=graphical-session.target
