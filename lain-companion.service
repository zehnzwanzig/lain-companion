[Unit]
Description=Lain Companion desktop GUI for Codex CLI
PartOf=graphical-session.target
After=plasma-plasmashell.service

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/lain-companion
ExecStart=/usr/bin/bash ./launch.sh
Restart=on-abnormal
RestartSec=5

[Install]
WantedBy=graphical-session.target
